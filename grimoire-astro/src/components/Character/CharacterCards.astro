---
import { getCollection } from 'astro:content';
import StatusBadge from '../StatusBadge.astro';
import SexIcon from '../SexIcon.astro';

const allDocs = await getCollection('docs');

const characters = allDocs.filter((doc) => {
  const tags = doc.data.tags as string[] | undefined;
  return (
    Array.isArray(tags) &&
    tags.includes('personaje/jugador') &&
    doc.id.startsWith('notes/personajes/') &&
    doc.id !== 'notes/personajes/index'
  );
});

characters.sort((a, b) => {
  const titleA = (a.data.title as string) ?? '';
  const titleB = (b.data.title as string) ?? '';
  return titleA.localeCompare(titleB, 'es');
});
---

{
  characters.length > 0 && (
    <div class="my-6">
      <div class="grid grid-cols-2 gap-5 max-[600px]:grid-cols-1">
        {characters.map((char) => {
          const title = (char.data.title as string) ?? 'Sin nombre';
          const nickname = char.data.nickname as string | undefined;
          const sex = char.data.sex as string | undefined;
          const status = char.data.status as string | undefined;

          return (
            <a
              href={`/${char.id}/`}
              class="flex flex-col min-w-0 min-h-37.5 p-5 border-2 border-(--sl-color-gray-4) rounded-lg bg-(--sl-color-gray-6) no-underline text-(--sl-color-gray-1) transition-all duration-200 hover:-translate-y-0.75 hover:shadow-[0_4px_16px_var(--sl-color-gray-6)] hover:border-(--sl-color-accent)"
            >
              <div class="flex justify-between items-start gap-2 p-4">
                <div>
                  <h3 class="m-0 text-[1.2rem] text-(--sl-color-gray-1) leading-tight overflow-hidden text-ellipsis whitespace-nowrap">
                    {title}
                    <SexIcon sex={sex} />
                  </h3>
                  {nickname && (
                    <p class="m-0 text-[0.95rem] italic text-(--sl-color-gray-3) leading-tight">
                      ({nickname})
                    </p>
                  )}
                </div>
                <StatusBadge status={status} fallback="vivo" />
              </div>
            </a>
          );
        })}
      </div>
    </div>
  )
}
