---
import SexIcon from '../../SexIcon.astro';

interface Props {
  title?: string;
  nickname?: string;
  class?: string;
  race?: string;
  sex?: string;
  death_date?: Date;
  death_cause?: string;
  death_location?: string;
  epitaph?: string;
}

function str(v?: string | null): string | undefined {
  if (v === undefined || v === null) return undefined;
  const trimmed = String(v).trim();
  return trimmed === '' ? undefined : trimmed;
}

const { title, death_date, sex, ...rawProps } = Astro.props;

const nickname = str(rawProps.nickname);
const characterClass = str(rawProps.class);
const race = str(rawProps.race);
const deathCause = str(rawProps.death_cause);
const deathLocation = str(rawProps.death_location);
const epitaph = str(rawProps.epitaph);

const subtitleParts = [characterClass, race].filter(Boolean);
const date = death_date
  ? new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      death_date,
    )
  : undefined;

const causeLocation = [deathCause, deathLocation].filter(Boolean).join(' · ');
---

<div class="border-4 border-double border-taupe rounded-md overflow-hidden bg-(--surface-muerto)">
  <div class="flex flex-col items-center gap-1 p-5 text-center">
    <span class="text-2xl leading-none" aria-hidden="true"> 💀 </span>
    <h2 class="m-0 text-bone">
      {title}
      {nickname && <span class="italic font-normal text-bone"> "{nickname}"</span>}
    </h2>
    {
      subtitleParts.length > 0 && (
        <p class="m-0 text-2xl font-heading font-semibold text-bone">
          {subtitleParts.join(' · ')}
          <SexIcon sex={sex} />
        </p>
      )
    }
  </div>
  <div class="flex flex-col items-center gap-1 p-5 text-center">
    {date && <p class="m-0 text-2xl text-bone">✝ {date}</p>}
    {causeLocation && <p class="m-0 text-bone">{causeLocation}</p>}
  </div>

  {
    epitaph && (
      <p class="m-0 px-8 py-5 text-center italic font-serif leading-relaxed text-(--sl-color-accent-high) border-t border-umber">
        "{epitaph}"
      </p>
    )
  }
</div>
