---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import CharacterSheet from './CharacterSheet.astro';
import Obituary from './Obituary.astro';
import CharacterCards from './CharacterCards.astro';
import Backlinks from './Backlinks.astro';
import TagList from './TagList.astro';
import TagLinker from './TagLinker.astro';

let slug = '';
let frontmatter: Record<string, unknown> = {};
let tags: string[] = [];

try {
  const route = Astro.locals.starlightRoute;
  slug = route.id;
  frontmatter = route.entry.data as Record<string, unknown>;
  tags = (frontmatter.tags as string[]) ?? [];
} catch {
  // starlightRoute not available
}

const isCharacterPage =
  slug.includes('personajes/') &&
  !slug.endsWith('personajes') &&
  !slug.endsWith('personajes/index') &&
  tags.includes('personaje/jugador');

const isPersonajesIndex = slug.endsWith('personajes') || slug.endsWith('personajes/index');

const isDeceased = isCharacterPage && frontmatter.estado === 'muerto';
---

<Default {...Astro.props}>
  {
    isDeceased && (
      <Obituary
        title={frontmatter.title as string}
        nickname={frontmatter.nickname as string}
        clase={frontmatter.clase as string}
        raza={frontmatter.raza as string}
        fecha_muerte={frontmatter.fecha_muerte as Date}
        causa_muerte={frontmatter.causa_muerte as string}
        lugar_muerte={frontmatter.lugar_muerte as string}
        epitafio={frontmatter.epitafio as string}
        lazos={frontmatter.lazos as string}
        puntos_fuertes={frontmatter.puntos_fuertes as string[]}
      />
    )
  }
  {
    isCharacterPage && !isDeceased && (
      <CharacterSheet
        clase={frontmatter.clase as string}
        raza={frontmatter.raza as string}
        estado={frontmatter.estado as string}
        alineamiento={frontmatter.alineamiento as string}
        personalidad={
          frontmatter.personalidad as Record<string, number | null | undefined> | undefined
        }
        origen={frontmatter.origen as string}
        ideales={frontmatter.ideales as string}
        lazos={frontmatter.lazos as string}
        defectos={frontmatter.defectos as string}
        puntos_fuertes={frontmatter.puntos_fuertes as string[]}
        puntos_debiles={frontmatter.puntos_debiles as string[]}
      />
    )
  }
  {isPersonajesIndex && <CharacterCards />}
  <slot />
  <TagLinker />
  <TagList tags={tags} />
  <Backlinks currentId={slug} />
</Default>
