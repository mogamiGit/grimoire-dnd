---
import Default from '@astrojs/starlight/components/MarkdownContent.astro';
import CharacterSheet from './Character/CharacterSheet.astro';
import CharacterHeader from './Character/CharacterHeader/CharacterHeader.astro';
import CharacterCards from './Character/CharacterCards.astro';
import Timeline from './Timeline/Timeline.astro';
import Backlinks from './Backlinks.astro';
import TagList from './TagList.astro';
import TagLinker from './TagLinker.astro';

let slug = '';
let frontmatter: Record<string, unknown> = {};
let tags: string[] = [];

try {
  const route = Astro.locals.starlightRoute;
  slug = route.id;
  frontmatter = route.entry.data as Record<string, unknown>;
  tags = (frontmatter.tags as string[]) ?? [];
} catch {
  // starlightRoute not available
}

const isCharacterPage =
  slug.includes('personajes/') &&
  !slug.endsWith('personajes') &&
  !slug.endsWith('personajes/index') &&
  tags.includes('personaje/jugador');

const isCharactersIndex = slug.endsWith('personajes') || slug.endsWith('personajes/index');
const isHome = slug === '';
---

<Default {...Astro.props}>
  {
    isCharacterPage && (
      <CharacterHeader
        title={frontmatter.title as string}
        nickname={frontmatter.nickname as string}
        class={frontmatter.class as string}
        race={frontmatter.race as string}
        sex={frontmatter.sex as string}
        status={frontmatter.status as string}
        alignment={frontmatter.alignment as string}
        death_date={frontmatter.death_date as Date}
        death_cause={frontmatter.death_cause as string}
        death_location={frontmatter.death_location as string}
        epitaph={frontmatter.epitaph as string}
        disappearance_date={frontmatter.disappearance_date as Date}
        disappearance_location={frontmatter.disappearance_location as string}
        last_seen_wearing={frontmatter.last_seen_wearing as string}
        reward={frontmatter.reward as string}
      />
    )
  }
  {
    isCharacterPage && (
      <CharacterSheet
        personality={
          frontmatter.personality as Record<string, number | null | undefined> | undefined
        }
        origin={frontmatter.origin as string}
        ideals={frontmatter.ideals as string}
        bonds={frontmatter.bonds as string}
        flaws={frontmatter.flaws as string}
        strengths={frontmatter.strengths as string[]}
        weaknesses={frontmatter.weaknesses as string[]}
      />
    )
  }
  {isCharactersIndex && <CharacterCards />}
  <slot />
  {isHome && <Timeline />}
  <TagLinker />
  <TagList tags={tags} />
  <Backlinks currentId={slug} />
</Default>
