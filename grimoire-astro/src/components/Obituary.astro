---
interface Props {
  title?: string;
  nickname?: string;
  clase?: string;
  raza?: string;
  fecha_muerte?: Date;
  causa_muerte?: string;
  lugar_muerte?: string;
  epitafio?: string;
  lazos?: string;
  puntos_fuertes?: string[];
}

function str(v?: string | null): string | undefined {
  if (v === undefined || v === null) return undefined;
  const trimmed = String(v).trim();
  return trimmed === '' ? undefined : trimmed;
}

function hasContent(arr?: string[]): boolean {
  return Array.isArray(arr) && arr.length > 0 && arr[0] !== '';
}

const { title, fecha_muerte, ...rawProps } = Astro.props;

const nickname = str(rawProps.nickname);
const clase = str(rawProps.clase);
const raza = str(rawProps.raza);
const causa_muerte = str(rawProps.causa_muerte);
const lugar_muerte = str(rawProps.lugar_muerte);
const epitafio = str(rawProps.epitafio);
const lazos = str(rawProps.lazos);
const puntos_fuertes = rawProps.puntos_fuertes;

const subtitleParts = [clase, raza].filter(Boolean);
const fecha = fecha_muerte
  ? new Intl.DateTimeFormat('es-ES', { year: 'numeric', month: 'long', day: 'numeric' }).format(
      fecha_muerte,
    )
  : undefined;

const labelClass =
  'block text-[0.7rem] font-bold uppercase tracking-wider text-[var(--sl-color-gray-3)] mb-0.5';
const textClass = 'm-0 text-[0.85rem] leading-relaxed';
---

<div
  class="mb-8 border-2 border-[var(--sl-color-gray-2)] rounded-lg overflow-hidden bg-[var(--sl-color-gray-6)]"
>
  {/* Header */}
  <div
    class="flex flex-col items-center gap-1 px-5 py-6 border-b-2 border-[var(--sl-color-gray-2)] bg-gradient-to-br from-[rgba(0,0,0,0.12)] to-[rgba(0,0,0,0.04)] text-center"
  >
    <span class="text-2xl leading-none" aria-hidden="true"> 💀 </span>
    <h2 class="m-0 mt-1 text-xl font-heading font-semibold">
      {title}
      {nickname && <span class="italic font-normal"> "{nickname}"</span>}
    </h2>
    {
      subtitleParts.length > 0 && (
        <p class="m-0 text-[0.85rem] text-[var(--sl-color-gray-2)]">{subtitleParts.join(' · ')}</p>
      )
    }
    {fecha && <p class="m-0 mt-1 text-[0.8rem] text-[var(--sl-color-gray-3)]">✝ {fecha}</p>}
  </div>

  {/* Epitaph */}
  {
    epitafio && (
      <p class="m-0 px-8 py-5 text-center italic font-serif text-[0.95rem] leading-relaxed border-b border-[var(--sl-color-gray-4)]">
        "{epitafio}"
      </p>
    )
  }

  {/* Details */}
  {
    (causa_muerte || lugar_muerte || lazos || hasContent(puntos_fuertes)) && (
      <div class="px-5 py-4 flex flex-col gap-2.5">
        {causa_muerte && (
          <div>
            <span class={labelClass}>Causa de la muerte</span>
            <p class={textClass}>{causa_muerte}</p>
          </div>
        )}
        {lugar_muerte && (
          <div>
            <span class={labelClass}>Lugar</span>
            <p class={textClass}>{lugar_muerte}</p>
          </div>
        )}
        {lazos && (
          <div>
            <span class={labelClass}>Deja atrás</span>
            <p class={textClass}>{lazos}</p>
          </div>
        )}
        {hasContent(puntos_fuertes) && (
          <div>
            <span class={labelClass}>Recordado por</span>
            <ul class="m-0 pl-5 text-[0.85rem] leading-relaxed marker:text-[var(--sl-color-gray-3)]">
              {puntos_fuertes!.map((p) => (
                <li class="mb-0.5">{p}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )
  }
</div>
