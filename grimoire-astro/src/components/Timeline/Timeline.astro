---
import TimelineCard from './TimelineCard.astro';
import { getTimeline } from '../../utils/timeline';

const entries = await getTimeline();
const last = entries.length - 1;
---

<div class="not-content relative max-w-3xl mx-auto">
  {
    entries.map((entry, i) => (
      <div class="flex gap-2">
        <div class="not-content flex flex-col items-center">
          <div class="w-3 h-3 rounded-full bg-[var(--sl-color-accent)] border border-(---sl-color-gray-5)" />
          {i < last && <div class="tl-line w-0.5 flex-1" />}
        </div>
        <div class="flex flex-col gap-5">
          <p class="text-sm font-bold text-xl leading-3 text-(--sl-color-text-accent)">
            {entry.label}
          </p>
          <div class="flex-1 flex flex-col gap-2 pb-8">
            <TimelineCard {entry} />
          </div>
        </div>
      </div>
    ))
  }
</div>
