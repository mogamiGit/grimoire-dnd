---
interface Props {
  estado?: string;
  fallback?: string;
}

const STATUS_LABELS: Record<string, string> = {
  vivo: '♥ Vivo',
  muerto: '💀 Muerto',
  desaparecido: '👁 Desaparecido',
};

const STATUS_COLORS: Record<string, string> = {
  vivo: 'bg-[#2d6a2e] text-[#e8f5e9]',
  muerto: 'bg-[#8b2020] text-[#fce4ec]',
  desaparecido: 'bg-[#b8860b] text-[#fff8e1]',
  otro: 'bg-[var(--sl-color-gray-4)] text-[var(--sl-color-gray-1)]',
};

const { estado, fallback } = Astro.props;
const status = estado || fallback;
const label = status ? (STATUS_LABELS[status] ?? status) : null;
const colorClass = status && STATUS_LABELS[status] ? STATUS_COLORS[status] : STATUS_COLORS.otro;
---

{
  label && (
    <span
      class={`inline-block px-3 py-1.5 rounded-full text-[0.7rem] font-bold uppercase tracking-[0.04em] whitespace-nowrap shrink-0 ${colorClass}`}
    >
      {label}
    </span>
  )
}
