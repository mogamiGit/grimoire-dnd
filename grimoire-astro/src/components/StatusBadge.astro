---
interface Props {
  status?: string;
  fallback?: string;
}

const STATUS_LABELS: Record<string, string> = {
  vivo: '♥ Vivo',
  muerto: '💀 Muerto',
  desaparecido: '👁 Desaparecido',
};

const STATUS_COLORS: Record<string, string> = {
  vivo: 'bg-forest text-mint',
  muerto: 'bg-crimson text-blush',
  desaparecido: 'bg-goldenrod-dark text-cream',
  otro: 'bg-[var(--sl-color-gray-6)] text-[var(--sl-color-gray-1)]',
};

const { status: rawStatus, fallback } = Astro.props;
const status = rawStatus || fallback;
const label = status ? (STATUS_LABELS[status] ?? status) : null;
const colorClass = status && STATUS_LABELS[status] ? STATUS_COLORS[status] : STATUS_COLORS.otro;
---

{
  label && (
    <div
      class:list={[
        'm-0 px-4 py-3 rounded-full text-[0.8rem] leading-none font-bold uppercase tracking-[0.04em] whitespace-nowrap shrink-0',
        colorClass,
      ]}
    >
      {label}
    </div>
  )
}
