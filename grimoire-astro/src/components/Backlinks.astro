---
import { getCollection } from 'astro:content';

interface Props {
  currentId: string;
}

const { currentId } = Astro.props;

const allDocs = await getCollection('docs');

// Build backlinks: find docs whose body links to this page
// starlight-obsidian converts wikilinks to standard markdown links: [text](/notes/path)
const backlinks: { title: string; href: string }[] = [];

// Match markdown links: [text](url) — capture url group
const mdLinkRegex = /\[(?:[^\]]*)\]\((?<url>[^)]+)\)/g;

// Normalize path for comparison: strip /notes/ prefix, trailing slash, /index
function normalizePath(p: string): string {
  return p.replace(/^\/notes\//, '').replace(/^notes\//, '').replace(/\/index$/, '').replace(/\/$/, '');
}

const normalizedCurrent = normalizePath(currentId);

for (const doc of allDocs) {
  if (doc.id === currentId) continue;
  if (!doc.body) continue;

  const matches = doc.body.matchAll(mdLinkRegex);
  for (const match of matches) {
    const target = match.groups?.url ?? '';
    if (target.startsWith('http')) continue; // skip external links

    if (normalizePath(target) === normalizedCurrent) {
      backlinks.push({
        title: (doc.data.title as string) ?? doc.id,
        href: `/${doc.id}/`,
      });
      break;
    }
  }
}

backlinks.sort((a, b) => a.title.localeCompare(b.title, 'es'));
---

{backlinks.length > 0 && (
  <div class="backlinks">
    <h2 class="backlinks__title">Enlaces a esta página</h2>
    <ul class="backlinks__list">
      {backlinks.map((link) => (
        <li>
          <a href={link.href}>{link.title}</a>
        </li>
      ))}
    </ul>
  </div>
)}

<style>
  .backlinks {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-3);
  }
  .backlinks__title {
    margin: 0 0 0.75rem;
    font-size: 1rem;
    font-family: var(--sl-font-headings);
    color: var(--sl-color-gray-5);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .backlinks__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .backlinks__list li {
    margin-bottom: 0.25rem;
  }
  .backlinks__list a {
    color: var(--sl-color-accent);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .backlinks__list a:hover {
    text-decoration: underline;
  }
</style>
