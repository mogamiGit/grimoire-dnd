{
  "name": "grimoire-astro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "prepare": "cd .. && husky grimoire-astro/.husky",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"*.{mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"*.{mjs,json}\""
  },
  "lint-staged": {
    "*.{astro,ts,css,mjs,json}": "prettier --write"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.41.2",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.0.2",
    "sharp": "^0.34.5",
    "starlight-obsidian": "^0.13.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
}
